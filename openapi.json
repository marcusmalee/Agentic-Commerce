    "/api/readiness-framework": {
      "get": {
        "summary": "Get the agentic-commerce readiness framework",
        "description": "SAMPLE ENDPOINT (not implemented). Would return the four readiness traits (discoverable, trustworthy, structured, transactable) and six illustrative service areas as structured JSON.",
        "operationId": "getReadinessFramework",
        "responses": {
          "200": {
            "description": "Readiness framework",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "traits": {
                      "type": "array",
                      "items": { "type": "string" },
                      "example": ["Discoverable", "Trustworthy", "Structured", "Transactable"]
                    },
                    "services": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string", "example": "01" },
                          "name": { "type": "string", "example": "Strategy and readiness" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/faq": {
      "get": {
